# Postgres (Neon via Vercel Marketplace injeta automaticamente)
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# Segredo para assinar o cookie de sessão (gere com: openssl rand -base64 32)
AUTH_SECRET=""

# E-mail (opcional — sem a chave, nenhum e-mail é enviado)
RESEND_API_KEY=""
EMAIL_FROM="Vôlei <volei@seudominio.com>"

# Superadmin criado pelo seed (npm run db:seed)
SEED_ADMIN_NAME="Admin"
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
